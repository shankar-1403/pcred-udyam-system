{
  "name": "pcred-udyam-scheme-report",
  "private": true,
  "description": "PCRED Udyam Scheme Report: React front end on Firebase Hosting, Cashfree Udyam verification in a Cloud Function.",
  "type": "module",
  "main": "functions/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --config functions/vitest.config.js",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "emulators": "npm run build && firebase emulators:start --only functions,hosting,database --project demo-pcred",
    "deploy:functions": "firebase deploy --only functions",
    "deploy": "firebase deploy --only functions,hosting",
    "logs": "firebase functions:log --only udyamVerify",
    "sync:artifact": "node scripts/sync-from-artifact.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "firebase-tools": "15.32.1",
    "jspdf": "4.2.1",
    "pdfjs-dist": "4.10.38",
    "playwright": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
