# For the local Functions emulator only. Copy to functions/.secret.local (git-ignored, never deployed).
# In production these come from Secret Manager (firebase functions:secrets:set ...).
CASHFREE_CLIENT_ID=your-production-client-id
CASHFREE_CLIENT_SECRET=your-production-client-secret
# The .pem as one line with \n between lines (or base64 of the whole file):
CASHFREE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBg...\n-----END PUBLIC KEY-----"
