# Optional, non-secret settings for the udyamVerify function. Copy to functions/.env to use.
# (Cashfree credentials are NOT set here: they are Firebase secrets. See the README.)

# Per-visitor limits (each verification is a paid Cashfree call)
UDYAM_RATE_LIMIT_PER_MINUTE=5
UDYAM_RATE_LIMIT_PER_DAY=30

# Other sites allowed to call the function from a browser, comma-separated.
# Not needed when the page is served by Firebase Hosting on the same domain.
UDYAM_ALLOWED_ORIGINS=

# Fast2SMS sends the OTP. Store the key as a Firebase secret, not in this file:
#   firebase functions:secrets:set FAST2SMS_API_KEY
# The key is on the Fast2SMS Dev API page. The text reads "Your OTP: 123456".
# Set to 1 to include the code in the API response. Do not enable this in production.
# OTP_DEV_ECHO=

# Realtime Database URL from the Firebase console. Cloud Functions usually receive this
# automatically. Set it when the function cannot find the database, including the emulator.
# FIREBASE_DATABASE_URL=https://pcred-udyam-system-default-rtdb.asia-southeast1.firebasedatabase.app
