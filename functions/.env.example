# Optional, non-secret settings for the udyamVerify function. Copy to functions/.env to use.
# (Cashfree credentials are NOT set here: they are Firebase secrets. See the README.)

# Per-visitor limits (each verification is a paid Cashfree call)
UDYAM_RATE_LIMIT_PER_MINUTE=5
UDYAM_RATE_LIMIT_PER_DAY=30

# Other sites allowed to call the function from a browser, comma-separated.
# Not needed when the page is served by Firebase Hosting on the same domain.
UDYAM_ALLOWED_ORIGINS=
